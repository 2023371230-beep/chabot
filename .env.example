# ============================================================
# PUBLICAS - viajan al navegador. Aqui NUNCA va un secreto.
# ============================================================
# Proyecto: zbukglthlybwbeevbozv
NEXT_PUBLIC_SUPABASE_URL=
# TODO: la PUBLISHABLE / ANON key (la publica, no la secret)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Las rutas de la API viven en este mismo proyecto (app/api/**). Ruta
# relativa: funciona igual en local y en Vercel, sin tocar nada al desplegar.
# Dejar VACIA: por defecto es /api, este mismo proyecto.
NEXT_PUBLIC_API_URL=

# DESARROLLO: entra al dashboard sin login. Quitar o poner false para reactivar
# la autenticacion. NUNCA dejar en true en produccion.
NEXT_PUBLIC_DISABLE_AUTH=

# ============================================================
# SECRETAS - solo se leen dentro de app/api/**/route.ts (server-side).
# Sin prefijo NEXT_PUBLIC_ nunca llegan al bundle del navegador.
# ============================================================
# Proyecto: zbukglthlybwbeevbozv
SUPABASE_URL=
# La SERVICE ROLE. Es la que salta RLS: si se filtra, se filtra todo.
SUPABASE_SECRET_KEY=   # service role, NUNCA la publica

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEST_NUMBER=

# ============================================================
# WHATSAPP — firma del webhook y alertas al encargado
# ============================================================
WHATSAPP_APP_SECRET=
WHATSAPP_ALERTA_NUMERO=

# A donde apuntan los enlaces de las alertas. En Vercel: tu dominio.
DASHBOARD_URL=

# ============================================================
# ALERTAS AL ENCARGADO
# ============================================================
# Tu celular con lada de pais y SIN el +. Cuando un chat necesite a una
# persona, te llega un WhatsApp aqui.
# OJO: Meta solo deja mandar texto libre a numeros que escribieron en las
# ultimas 24 h. El aviso del dashboard no tiene esa limitacion.
WHATSAPP_ALERTA_NUMERO=

# A donde apuntan los enlaces de las alertas. En Vercel se puede dejar vacia:
# se usa VERCEL_URL automaticamente.
DASHBOARD_URL=
